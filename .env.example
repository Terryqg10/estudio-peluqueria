# .env.example — Plantilla de variables de entorno
#
# Este archivo SE VERSIONA. Solo contiene NOMBRES de variables, nunca valores.
# Copia a .env.local y rellena con los valores reales:
#     cp .env.example .env.local
#
# El archivo .env.local y cualquier .env.* están ignorados por git.
#
# Reglas (constitución, invariante I4):
#  - Ninguna clave real en este archivo. Nunca.
#  - Las variables que empiezan por NEXT_PUBLIC_ se exponen al navegador:
#    NO pongas secretos ahí.
#  - Las claves de API de pago viven solo en el servidor.

# Aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos (si se usa Postgres/Supabase)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# APIs externas (ejemplos; borra las que no uses)
# API_KEY=

# Analítica (opcional)
# NEXT_PUBLIC_ANALYTICS_ID=
