# .env.example — Plantilla de variables de entorno
#
# Este archivo SE VERSIONA. Solo contiene NOMBRES de variables, nunca valores.
# Copia a .env.local y rellena con los valores reales:
#     cp .env.example .env.local
#
# El archivo .env.local y cualquier .env.* están ignorados por git.
#
# Reglas (constitución, invariante I4):
#  - Ninguna clave real en este archivo. Nunca.
#  - Las variables que empiezan por NEXT_PUBLIC_ se exponen al navegador:
#    NO pongas secretos ahí.
#  - Las claves de API de pago viven solo en el servidor.

# Aplicación
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de datos (si se usa Postgres/Supabase)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# APIs externas (ejemplos; borra las que no uses)
# API_KEY=

# Analítica (opcional)
# NEXT_PUBLIC_ANALYTICS_ID=
# Antiabuso de la reserva (ADR-0020). Solo servidor. Obligatoria en producción.
RATE_LIMIT_SALT=
# Solo desarrollo: 1 activa el límite por IP (apagado por defecto fuera de producción).
RATE_LIMIT_IP_ENFORCE=
# Emails (ADR-0017). En local se usa Mailpit y no hace falta nada de esto.
# En producción son obligatorias: EMAIL_PROVIDER=resend, EMAIL_FROM con un dominio verificado y APP_URL con https.
# EMAIL_PROVIDER=
# EMAIL_FROM=
# RESEND_API_KEY=
# APP_URL=

# Demo de portfolio (ADR-0036). Con DEMO_ENABLED=1 aparece «Probar el panel» (cuenta de solo lectura). Sin ella no existe.
# DEMO_ENABLED=

# Límite por IP fuera de producción (en producción siempre está activo). Opcional.
# RATE_LIMIT_IP_ENFORCE=