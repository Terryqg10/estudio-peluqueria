{
  "name": "peluqueria",
  "version": "0.1.0",
  "private": true,
  "description": "Quiero una pagina de peluqueria, enfocado en mujeres, donde enseña los mejores resultados y si es buena practica enseña los precios. Ademas de reservacion de cita, escogiendo dia y hora, donde la disponibilidad estara en tiempo real.",
  "author": "terry",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:e2e:install": "playwright install --with-deps chromium webkit",
    "test:e2e": "playwright test",
    "test:e2e:dev": "node scripts/test-e2e-dev.mjs",
    "test:a11y": "node scripts/check-a11y.mjs",
    "check-palette": "node scripts/check-palette.mjs",
    "check-secrets": "node scripts/check-secrets.mjs",
    "check-audit": "node scripts/check-audit.mjs",
    "install-hooks": "node scripts/install-hooks.mjs",
    "db:types": "node scripts/db-types.mjs",
    "backup": "node scripts/backup.mjs",
    "verify": "node scripts/verify.mjs",
    "admin:promote": "node scripts/admin-promote.mjs",
    "retention": "node scripts/retention.mjs",
    "db:reset:local": "node scripts/db-reset-local.mjs",
    "check-db-clean": "node scripts/check-db-clean.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.577.0",
